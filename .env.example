# PPM Studio Pro Environment Configuration Example
# Copy this file to .env and configure as needed.
# ==============================================================================
# PPM Studio Pro - Environment Variables Configuration
# ==============================================================================

# PostgreSQL runtime credentials; apply migrations before starting the app.
# Generate local values with: python -m scripts.configure_postgresql
DATABASE_URL=postgresql://eppm_app:<runtime-password>@postgres:5432/eppm
DATABASE_CONTEXT_KEY=<generated-32-byte-hex-key>

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application Runtime Environment (development, staging, production)
APP_ENV=production

# Startup performance mode: auto, development, demo, production.
# auto follows APP_ENV: development watches source; staging/production do not.
# demo disables source watching without changing APP_ENV or OIDC security.
APP_RUN_MODE=auto
# Optional watcher override: auto, none, poll, watchdog. Empty follows run mode.
APP_FILE_WATCHER_TYPE=

# OIDC production settings. Local Keycloak: python -m scripts.configure_local_oidc
# Values are read explicitly; no implicit Streamlit secrets.toml mapping is used.
APP_ORIGIN=https://eppm.example.test
APP_COOKIE_SECRET=<random-secret-at-least-32-characters>
OIDC_ISSUER=https://identity.example.test/realms/eppm
OIDC_CLIENT_ID=<registered-confidential-client-id>
OIDC_CLIENT_SECRET=<deployment-managed-client-secret>
OIDC_ALLOW_LOCAL_HTTP=false
OIDC_SIGNING_ALGORITHMS=RS256
# Exact ACR values that the deployment has verified attest enforced provider MFA.
OIDC_MFA_ACR_VALUES=<verified-mfa-acr>
SESSION_IDLE_SECONDS=900
SESSION_REAUTHENTICATION_SECONDS=300

# Seeding/reset is an explicit deployment-side maintenance operation.
# Application startup never resets business data or restores access grants.

# Optional pgAdmin only: select docker-compose.pgadmin.yml and the tools profile.
# Store actual values in an ignored private file, never this example.
PGADMIN_PASSWORD=<private-pgadmin-password>
PGADMIN_EMAIL=<your-email-address>
